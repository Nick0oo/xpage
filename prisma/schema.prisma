generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./xpage.db"
}

model SavedLanding {
  id               String   @id
  title            String
  briefJson        String
  techniqueIdsJson String
  prompt           String
  html             String
  css              String
  js               String
  createdAt        DateTime
  traceId          String?
  trace            GenerationTrace? @relation(fields: [traceId], references: [id], onDelete: SetNull)
}

model GenerationTrace {
  id          String                @id
  category    String
  title       String
  contextJson String
  status      String                @default("active")
  rootTraceId String?
  parentTraceId String?
  sourceTraceId String?
  executionId String @default("")
  sequenceCounter Int @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  steps       GenerationTraceStep[]
  landings    SavedLanding[]
}

model GenerationTraceStep {
  id                String          @id
  traceId           String
  sequence          Int
  executionId       String @default("")
  rootTraceId       String?
  parentTraceId     String?
  parentStepId      String?
  eventType         String @default("step")
  skillVersionsJson String?
  decisionSummary   String?
  referencesJson    String?
  metadataJson      String?
  phase             String
  title             String
  techniqueIdsJson  String?
  provider          String?
  model             String?
  systemPrompt      String?
  userPrompt        String?
  outputText        String?
  outputJson        String?
  status            String          @default("completed")
  errorMessage      String?
  durationMs        Int?
  createdAt         DateTime        @default(now())
  trace             GenerationTrace @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@index([traceId, sequence])
  @@unique([executionId, sequence])
}
