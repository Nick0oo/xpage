generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./xpage.db"
}

model SavedLanding {
  id               String                @id
  title            String
  briefJson        String
  techniqueIdsJson String
  prompt           String
  html             String
  css              String
  js               String
  createdAt        DateTime
  traceId          String?
  sectionRevision  Int                   @default(0)
  trace            GenerationTrace?      @relation(fields: [traceId], references: [id], onDelete: SetNull)
  mediaAssets      MediaAsset[]
  sectionRevisions SectionRevision[]
  sectionProposals SectionEditProposal[]
}

model SectionRevision {
  id               String       @id
  savedLandingId   String
  revision         Int
  parentRevisionId String?
  sourceRevisionId String?
  sectionId        String?
  summary          String
  html             String
  css              String
  js               String
  createdAt        DateTime     @default(now())
  savedLanding     SavedLanding @relation(fields: [savedLandingId], references: [id], onDelete: Cascade)

  @@unique([savedLandingId, revision])
  @@index([savedLandingId, createdAt])
}

model SectionEditProposal {
  id               String       @id
  savedLandingId   String
  baseRevision     Int
  baseFingerprint  String
  sectionId        String
  techniqueIdsJson String
  modelChoice      String
  instruction      String
  patchJson        String
  status           String       @default("pending")
  revisionId       String?
  createdAt        DateTime     @default(now())
  savedLanding     SavedLanding @relation(fields: [savedLandingId], references: [id], onDelete: Cascade)

  @@index([savedLandingId, createdAt])
}

model MediaAsset {
  id              String       @id
  type            String
  sourceType      String
  provider        String
  providerAssetId String
  author          String
  sourceUrl       String
  creditUrl       String
  license         String
  mimeType        String
  width           Int?
  height          Int?
  durationSeconds Int?
  localPath       String
  posterPath      String?
  sectionId       String
  slotId          String
  altText         String
  isCurrent       Boolean      @default(true)
  createdAt       DateTime     @default(now())
  savedLandingId  String
  savedLanding    SavedLanding @relation(fields: [savedLandingId], references: [id], onDelete: Cascade)

  @@index([savedLandingId, sectionId, slotId])
}

model GenerationTrace {
  id              String                @id
  category        String
  title           String
  contextJson     String
  status          String                @default("active")
  rootTraceId     String?
  parentTraceId   String?
  sourceTraceId   String?
  executionId     String                @default("")
  sequenceCounter Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  steps           GenerationTraceStep[]
  landings        SavedLanding[]
}

model GenerationTraceStep {
  id                String          @id
  traceId           String
  sequence          Int
  executionId       String          @default("")
  rootTraceId       String?
  parentTraceId     String?
  parentStepId      String?
  eventType         String          @default("step")
  skillVersionsJson String?
  decisionSummary   String?
  referencesJson    String?
  metadataJson      String?
  phase             String
  title             String
  techniqueIdsJson  String?
  provider          String?
  model             String?
  systemPrompt      String?
  userPrompt        String?
  outputText        String?
  outputJson        String?
  status            String          @default("completed")
  errorMessage      String?
  durationMs        Int?
  createdAt         DateTime        @default(now())
  trace             GenerationTrace @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@unique([executionId, sequence])
  @@index([traceId, sequence])
}
